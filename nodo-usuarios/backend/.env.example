# Copia este archivo a .env y cambia los valores. No subas .env al repositorio.
# Genera una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-al-menos-32-caracteres
# PostgreSQL de docker-compose.yml (npm run db:start). En producción, el de tu servidor.
DATABASE_URL=postgresql+psycopg://nodo:nodo@127.0.0.1:5433/nodo
TOKEN_MINUTES=60
# Pon true cuando sirvas la app por HTTPS.
COOKIE_SECURE=false

# Usuario administrador que se crea solo si la base de datos no tiene usuarios.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Recuperación de contraseña
# URL pública del front-end: se usa para construir el enlace del correo.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
# Validez del enlace de invitación que recibe cada usuario nuevo.
INVITE_TOKEN_HOURS=24
# Máximo de invitaciones (alta + reenvíos) que puede recibir un usuario en 24 horas.
INVITE_MAX_PER_DAY=5
# Sin SMTP_HOST, el enlace se muestra en la consola del backend (solo para desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nodo <no-reply@example.com>
SMTP_STARTTLS=true
