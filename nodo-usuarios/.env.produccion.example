# Copia este archivo a .env.produccion, rellénalo y no lo subas al repositorio.
# Genera cada secreto con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Dominio público. Debe apuntar (registro DNS A/AAAA) a este servidor, con los puertos 80 y 443
# abiertos, para que Caddy obtenga el certificado de Let's Encrypt.
DOMINIO=nodo.example.com

POSTGRES_PASSWORD=
SECRET_KEY=
TOKEN_MINUTES=60

# Usuario administrador que se crea solo si la base de datos no tiene usuarios.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

RESET_TOKEN_MINUTES=30
INVITE_TOKEN_HOURS=24
INVITE_MAX_PER_DAY=5

# En producción configura el SMTP: sin él, los enlaces solo aparecen en el log de la API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nodo <no-reply@example.com>
SMTP_STARTTLS=true
